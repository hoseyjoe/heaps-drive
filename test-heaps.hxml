# Heaps tests that need a window (HL): synthetic input through hxd.Window.event, real hit-testing.
-cp src
-cp tests-heaps
-lib heaps
-lib hlsdl
-D drive
-D windowSize=800x600
-main H2dCommandsTest
-hl bin/test-heaps/H2dCommandsTest.hl
--debug
--cmd hl bin/test-heaps/H2dCommandsTest.hl

--next

# The HaxeUI finder, and a press reaching HaxeUI through hxd.Window.event (MouseHelper).
-cp src
-cp tests-heaps
-lib heaps
-lib hlsdl
-lib haxeui-core
-lib haxeui-heaps
-D drive
-D resourcesPath=tests-heaps/res
-main HaxeuiTest
-hl bin/test-heaps/HaxeuiTest.hl
--debug
--cmd hl bin/test-heaps/HaxeuiTest.hl
